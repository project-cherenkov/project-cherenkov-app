# Content itself is still git-committed MDX with no required env vars.
# The two blocks below are optional Phase 1 additions (Keystatic + Blob):
# omit them entirely to use local-storage Keystatic (no GitHub OAuth) and
# skip the team-photo upload path.

# --- Keystatic (spec §11 CMS-006) ----------------------------------------
# Only needed for the github-storage flow (production). Without these,
# keystatic.config.ts falls back to { kind: "local" } automatically — build
# and test that path first. Do not set these until a GitHub OAuth App
# exists and the org/repo is confirmed (GATHER-001 item 7); until then,
# KEYSTATIC_GITHUB_REPO below is a placeholder, not a real value.
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET="generate-with: openssl rand -base64 32"
# KEYSTATIC_GITHUB_REPO="PLACEHOLDER-org/PLACEHOLDER-repo"

# --- Vercel Blob (spec §11 BLOB-003) --------------------------------------
# Powers the team-photo upload path (app/api/team-photo/route.ts). Do not
# implement/test that route's live upload behaviour until a Blob store
# exists and this token is set — see BLOB-003's explicit precondition.
# BLOB_READ_WRITE_TOKEN=

# --- Phase 2 (not needed yet) -------------------------------------------

# Neon serverless Postgres connection string.
# DATABASE_URL="postgresql://user:password@ep-example-123456.region.aws.neon.tech/cherenkov?sslmode=require"

# Better Auth
# BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
# BETTER_AUTH_URL="http://localhost:3000"

# OAuth providers — PLACEHOLDER: no provider has been chosen yet
# (Open Questions §12). Don't wire one up without asking first.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
