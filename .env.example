# Content itself is still git-committed MDX with no required env vars.
# The two blocks below are optional Phase 1 additions (Keystatic + Blob):
# omit them entirely to use local-storage Keystatic (no GitHub OAuth) and
# skip the team-photo upload path.

# --- Keystatic (spec §11 CMS-006) ----------------------------------------
# Only needed for the github-storage flow (production). Without these,
# keystatic.config.ts falls back to { kind: "local" } automatically — build
# and test that path first. The org/repo is confirmed
# (project-cherenkov/project-cherenkov-app, GATHER-001 item 7) and is now
# keystatic.config.ts's own fallback if this var is unset — still requires
# a real GitHub OAuth App's client ID/secret before github-storage mode
# actually activates (see lib/admin-guard.ts: that's also what makes
# /keystatic reachable on a deployed build at all).
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET="generate-with: openssl rand -base64 32"
# KEYSTATIC_GITHUB_REPO="project-cherenkov/project-cherenkov-app"
# Comma-separated email allow-list for team-photo uploads.
# ADMIN_EMAILS="editor@example.com"

# --- Vercel Blob (spec §11 BLOB-003) --------------------------------------
# Powers the team-photo upload path (app/api/team-photo/route.ts). Do not
# implement/test that route's live upload behaviour until a Blob store
# exists and this token is set — see BLOB-003's explicit precondition.
# BLOB_READ_WRITE_TOKEN=

# --- Site URL  ------------------------
# Absolute origin used by app/sitemap.ts, app/robots.ts, and Open Graph
# metadata (app/[locale]/layout.tsx). Falls back to http://localhost:3000
# if unset, so dev/build/CI all work with zero configuration. Set this in
# Vercel's project settings once the real domain is known — no code change
# needed.
# NEXT_PUBLIC_SITE_URL="https://your-domain.example"

# --- Phase 2: accounts + study planner ------------------------------------
# All optional for local dev/CI — lib/db/index.ts and lib/auth.ts are both
# lazily constructed, so Phase 1's own build/dev/lint/typecheck succeed with
# every var below unset. Without DATABASE_URL, any request that reaches
# /planner/** or /api/auth/** fails closed (treated as unauthenticated —
# see lib/auth-guard.ts) rather than 500ing.

# Neon serverless Postgres connection string.
# DATABASE_URL="postgresql://user:password@ep-example-123456.region.aws.neon.tech/cherenkov?sslmode=require"

# Better Auth
# BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
# BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (decision #1: Google + email/password, confirmed — no longer
# an open question). Email/password sign-up/sign-in always works with zero
# vars here; the "Continue with Google" button only renders
# (components/auth/login-form.tsx / signup-form.tsx) once both are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
