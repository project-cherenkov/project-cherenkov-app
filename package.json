{
  "name": "project-cherenkov",
  "version": "0.1.0",
  "private": true,
  "description": "Project Cherenkov — Indonesian OSN (informatics/physics/astronomy) editorial archive with interactive visualizations.",
  "scripts": {
    "dev": "concurrently -n next,velite -c blue,green \"next dev\" \"velite dev\"",
    "build": "velite build && next build",
    "generate": "velite build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "pnpm generate && tsx scripts/seed-topics.ts && tsx scripts/seed-quiz-questions.ts"
  },
  "dependencies": {
    "@keystatic/core": "^0.6.8",
    "@keystatic/next": "^5.0.5",
    "@neondatabase/serverless": "^0.10.4",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@vercel/blob": "^2.8.0",
    "better-auth": "~1.4.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "drizzle-orm": "^0.45.2",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.11",
    "lucide-react": "^0.462.0",
    "next": "^15.1.0",
    "next-intl": "^3.26.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^2.5.5",
    "velite": "^0.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/typography": "^0.5.15",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@9.15.0"
}
